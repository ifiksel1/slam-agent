# ArduPilot Copter params — FAST-LIVO2 external-nav (GPS-denied) on CubeOrange
# Generated by SLAM Integration Agent — Phase 3 (2026-06-06)
# Load with: MAVProxy `param load`, or Mission Planner Full Param Tree.
# Lines starting with # are ignored by the loaders.
#
# ===== EKF3 + External Navigation =====
AHRS_EKF_TYPE,3
EK3_ENABLE,1
EK3_SRC1_POSXY,6      # 6 = ExternalNav (FAST-LIVO2 horizontal position)
EK3_SRC1_VELXY,6      # 6 = ExternalNav horizontal velocity
EK3_SRC1_POSZ,1       # 1 = Baro (safer default). Switch to 6 if indoor baro drift > budget.
EK3_SRC1_VELZ,6       # ExternalNav vertical velocity
EK3_SRC1_YAW,6        # 6 = ExternalNav yaw (GPS/compass-denied)
#
# ===== Visual Odometry input =====
VISO_TYPE,2           # 2 = MAVLink VISION_POSITION_ESTIMATE
VISO_DELAY_MS,0       # TODO Phase 5/7: set to measured p95 latency + 10 ms
#
# ===== Arming / sensors (GPS-denied) =====
ARMING_CHECK,388598   # all checks except GPS
GPS_TYPE,0            # disable GPS (indoor/denied). Re-enable for outdoor GPS-aided ops.
#
# ===== Geofence (TUNE to venue) =====
FENCE_ENABLE,1
FENCE_TYPE,7          # cylinder + altitude
FENCE_ACTION,1        # RTL on breach
FENCE_RADIUS,100      # m — set to hangar/operating area
FENCE_ALT_MAX,30      # m
FENCE_ALT_MIN,-1
#
# ===== Waypoint speeds (mission target: 10 m/s) =====
# NOTE: Phase 5 testing starts conservative (e.g. 300). Ramp to 1000 only after stable hover+ground.
WPNAV_SPEED,1000      # cm/s = 10 m/s
WPNAV_SPEED_UP,250    # cm/s
WPNAV_SPEED_DN,150    # cm/s
