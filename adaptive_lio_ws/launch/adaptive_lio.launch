<?xml version="1.0"?>
<!-- Standalone Adaptive-LIO node (SLAM only, no MAVROS/flight stack).
     Generated by SLAM Integration Agent.

     Adaptive-LIO reads its config from a COMPILE-TIME path (ROOT_DIR + config/mapping_m.yaml),
     NOT a ROS param, so there is nothing to pass here — the Ouster config was baked in at build
     (and the run scripts bind-mount config/mapping_ouster.yaml over it for live tuning).

     Published by the (frame-namespaced) node:
       /odom            nav_msgs/Odometry   frame alio_odom  -> child alio_body
       /odometry_path   nav_msgs/Path
       /scan            sensor_msgs/PointCloud2 (frame alio_odom)
       TF: alio_world->alio_odom, alio_odom->alio_body
     Set use_sim_time:=true for bag replay (rosbag play drives /clock); false for live sensor. -->
<launch>
  <arg name="rviz"         default="false"/>
  <arg name="use_sim_time" default="true"/>
  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <node pkg="adaptive_lio" type="adaptive_lio" name="adaptive_lio" output="screen" required="true"/>

  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="adaptive_lio_rviz"
          args="-d $(find adaptive_lio)/launch/rviz.rviz" launch-prefix="nice"/>
  </group>
</launch>
