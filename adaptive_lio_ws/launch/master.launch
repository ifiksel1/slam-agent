<?xml version="1.0"?>
<!-- Adaptive-LIO full stack: MAVROS + URDF/RSP + SLAM + vision bridge, for GPS-denied ArduPilot.
     Generated by SLAM Integration Agent. Mirrors the validated FAST-LIVO2 master.launch chain on
     this rig, retargeted to Adaptive-LIO's namespaced frames (alio_odom / alio_body / alio_world).

     TF CHAIN (bridges the MAVROS "map" island to the SLAM tree, same shape as FAST-LIVO2):
       map -> alio_odom          : static, identity (or Rz(-yaw0) once zero_initial_yaw is wired)
       alio_odom -> alio_body    : broadcast by Adaptive-LIO (the live SLAM pose)
       alio_body -> base_link    : static, Ry(pi) upside-down-mount correction (Ouster 6 cm below FCU)
     vision_to_mavros then looks up base_link in map and publishes /mavros/vision_pose/pose.

     >>> TWO THINGS MUST BE VERIFIED ON THE RIG BEFORE FLIGHT (Phase 5) <<<
     (1) YAW SIGN. EllipseLIO/SuperOdom on this rig read physical CCW as a yaw DECREASE and needed
         yaw negated. Adaptive-LIO's convention may differ — measure a known +90 deg CCW turn and,
         if world yaw comes out inverted, negate it (add zero_initial_yaw.py sign:=-1.0, or a yaw
         flip in the bridge). Left un-negated here as the neutral starting point.
     (2) The alio_body->base_link correction assumes Adaptive-LIO's body frame == os_imu (identity
         lidar-IMU extrinsic + upside-down mount). Confirm with check_tf_tree before Loiter/Guided. -->
<launch>

  <!-- ===== MAVROS (ArduPilot) ===== -->
  <arg name="fcu_url" default="/dev/serial/by-id/usb-Hex_ProfiCNC_CubeOrange-bdshot_450035000851313231383238-if00:115200"/>
  <arg name="gcs_url" default=""/>
  <include file="$(find mavros)/launch/apm.launch">
    <arg name="fcu_url" value="$(arg fcu_url)"/>
    <arg name="gcs_url" value="$(arg gcs_url)"/>
  </include>

  <!-- ===== Robot description / TF ===== -->
  <param name="robot_description" textfile="$(find adaptive_lio_ws)/urdf/drone.urdf"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>

  <!-- ===== TF bridge: map -> alio_odom (identity) =====
       Connects the MAVROS-owned "map" island to Adaptive-LIO's odom frame. Replace with a
       Rz(-yaw0) yaw-zeroing publisher in Phase 5 if world yaw must be repeatable across restarts. -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="map_to_alio_odom"
        args="0 0 0 0 0 0 map alio_odom"/>

  <!-- ===== TF fix: alio_body -> base_link =====
       Corrects the Ouster IMU upside-down mounting (Ry(pi)), 6 cm below the FCU.
       Transform = inverse of base_link->os_imu: T=[-0.006253, 0.011775, -0.067645], rpy=(0,pi,0).
       static_transform_publisher arg order: x y z yaw pitch roll parent child. -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="alio_body_to_base_link"
        args="-0.006253 0.011775 -0.067645 0 3.14159265 0 alio_body base_link"/>

  <!-- ===== SLAM (Adaptive-LIO) ===== -->
  <include file="$(find adaptive_lio_ws)/launch/adaptive_lio.launch">
    <arg name="use_sim_time" value="false"/>   <!-- live sensor -->
    <arg name="rviz"         value="false"/>
  </include>

  <!-- ===== vision_to_mavros bridge ===== -->
  <!-- Looks up base_link in map via TF and republishes as /mavros/vision_pose/pose.
       All cam rotations 0: the static TFs above already encode the orientation correction. -->
  <node pkg="vision_to_mavros" type="vision_to_mavros_node" name="vision_to_mavros_bridge" output="screen">
    <param name="use_tf"          value="true"/>
    <param name="target_frame_id" value="map"/>
    <param name="source_frame_id" value="base_link"/>
    <param name="output_rate"     value="30"/>
    <param name="gamma_world"     value="0"/>
    <param name="roll_cam"        value="0"/>
    <param name="pitch_cam"       value="0"/>
    <param name="yaw_cam"         value="0"/>
    <remap from="~vision_pose" to="/mavros/vision_pose/pose"/>
  </node>

</launch>
