<?xml version="1.0"?>
<!-- Dragunfly TF tree for FAST-LIVO2 integration (derived from ultraviewdev_ws/dragunfly_tf.urdf)
     Generated by SLAM Integration Agent — Phase 3 (2026-06-06)
     base_link is at the CubeOrange (FCU). The Ouster driver publishes os_sensor->os_lidar
     and os_sensor->os_imu static TFs itself (pub_static_tf:=true), so we only define
     base_link -> os_sensor here. -->
<robot name="dragunfly">

  <!-- Flight controller / body origin -->
  <link name="base_link"/>

  <!-- CubeOrange FCU frame (coincident with base_link on this airframe) -->
  <link name="fcu"/>
  <joint name="fcu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="fcu"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Ouster OS1-64, mounted UPSIDE-DOWN 6 cm below base_link.
       rpy = (0, pi, 0) → 180° about Y, matching dragunfly_tf.urdf lidar_joint. -->
  <link name="os_sensor"/>
  <joint name="base_to_ouster" type="fixed">
    <parent link="base_link"/>
    <child  link="os_sensor"/>
    <origin xyz="0 0 -0.060" rpy="0 3.14159265359 0"/>
  </joint>

  <!-- os_sensor -> os_lidar and os_sensor -> os_imu are published by the Ouster ROS driver. -->

</robot>
