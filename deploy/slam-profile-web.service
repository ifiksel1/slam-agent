[Unit]
Description=SLAM environment-profile web switch (open/tight/confined/tunnel, phone UI on :8089)
Documentation=https://github.com/ifiksel1/slam-agent
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=revolute
Group=revolute
WorkingDirectory=/home/revolute/Documents
Environment=PORT=8089
# Zero-dependency stdlib server; calls switch_slam_profile.sh (docker access via the docker group).
ExecStart=/usr/bin/python3 /home/revolute/Documents/profile_switch_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
