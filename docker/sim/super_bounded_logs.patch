@@ -144,6 +147,34 @@ namespace fsm {
 
     protected:
         vector<LogOneReplan> replan_logs_;
+
+        // Revolute (super_bounded_logs.patch): upstream appended one LogOneReplan (with its CIRI point cloud,
+        // ~90 KB) to replan_logs_ on every replan and every PlanFromRest attempt and never dropped any, for the
+        // binary log written at shutdown. A from-rest plan that kept failing (100 Hz main timer) grew fsm_node
+        // ~10 MB/s (34 GB in 80 min, SITL 2026-11-02). Keep only the latest entries.
+        static constexpr size_t kMaxReplanLogs = 200;
+        template<class T>
+        static void pushBounded(std::vector<T> &v, const T &x, const size_t cap) {
+            if (v.size() >= cap) {
+                v.erase(v.begin(), v.begin() + cap / 2);   // drop the older half: amortised O(1) per push
+            }
+            v.push_back(x);
+        }
+        void pushReplanLog() {
+            pushBounded(replan_logs_, planner_ptr_->getLatestReplanLog(), kMaxReplanLogs);
+        }
+
+        // Revolute: back off between failed PlanFromRest attempts (upstream retried on every 100 Hz main-timer
+        // tick, ~9 log lines each: 2.5 M lines in 80 min). Delay doubles from kFromRestRetryMinS to
+        // kFromRestRetryMaxS; reset on success and on every new goal.
+        static constexpr double kFromRestRetryMinS = 0.05;
+        static constexpr double kFromRestRetryMaxS = 0.5;
+        int from_rest_fail_cnt_{0};
+        double from_rest_retry_t_{0.0};
+        void resetFromRestBackoff() {
+            from_rest_fail_cnt_ = 0;
+            from_rest_retry_t_ = 0.0;
+        }
         /* Callback functions */
         bool finish_plan = false;
         double system_start_time_;
