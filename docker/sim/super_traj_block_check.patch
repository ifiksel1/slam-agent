+    bool Fsm::checkCommittedTraj(const std::string &why) {
+        Vec3f hit_p;
+        double hit_dt;
+        if (machine_state_ != FOLLOW_TRAJ ||
+            !planner_ptr_->committedTrajBlocked(kBlockCheckHorizonS, kBlockSkipDis, kBlockBodyR, hit_p, hit_dt)) {
+            return false;
+        }
+        fmt::print(fg(fmt::color::red), " -- [Fsm] Committed trajectory blocked at [{:.2f}, {:.2f}, {:.2f}], {:.2f} s "
+                   "ahead ({}).\n", hit_p.x(), hit_p.y(), hit_p.z(), hit_dt, why);
+        enterEmerStop("committed trajectory blocked");
+        return true;
+    }
+
+    void Fsm::enterEmerStop(const std::string &why) {
+        planner_ptr_->getRobotState(robot_state_);
+        emer_stop_p_ = robot_state_.p;
+        emer_start_t_ = ros_ptr_->getSimTime();
+        emer_brake_ = true;
+        emer_cnt_++;
+        emer_v_p_ = robot_state_.p;
+        emer_v_t_ = emer_start_t_;
+        emer_speed_ = 1e9;   // unknown until 0.2 s of braking
+        fmt::print(fg(fmt::color::red), " -- [Fsm] EMER_STOP {} ({}): braking stop at [{:.2f}, {:.2f}, {:.2f}].\n",
+                   emer_cnt_, why, emer_stop_p_.x(), emer_stop_p_.y(), emer_stop_p_.z());
+        ChangeState("EmerStop", EMER_STOP);
+    }
