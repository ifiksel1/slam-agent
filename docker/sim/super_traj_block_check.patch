diff --git a/super_planner/src/super_core/super_planner.cpp b/super_planner/src/super_core/super_planner.cpp
index a7a9826..7ce81f7 100755
--- a/super_planner/src/super_core/super_planner.cpp
+++ b/super_planner/src/super_core/super_planner.cpp
@@ -1201,6 +1201,59 @@ namespace super_planner {
     }
 
 
+    bool SuperPlanner::committedTrajBlocked(const double &horizon_s, const double &skip_dis, const double &body_r,
+                                            Vec3f &hit_p, double &hit_dt) {
+        cmd_traj_info_.lock();
+        if (cmd_traj_info_.empty()) {
+            cmd_traj_info_.unlock();
+            return false;
+        }
+        const double now_t = std::max(0.0, ros_ptr_->getSimTime() - cmd_traj_info_.getStartWallTime());
+        const double total = cmd_traj_info_.getTotalDuration();
+        double t_end = std::min(total, now_t + horizon_s);
+        if (cmd_traj_info_.backupTrajAvilibale() && cmd_traj_info_.getBackupTrajStartTT() < t_end) {
+            t_end = total;   // committed to the backup's brake: check it to its stop
+        }
+        const Vec3f p_now = cmd_traj_info_.getPos(std::min(now_t, total));
+        const double res = cfg_.resolution;
+        // body_r <= 0: the planner's own robot_r less half a cell (CIRI keeps robot_r from the cell centres)
+        const double br = body_r > 0 ? body_r : cfg_.robot_r - 0.5 * res;
+        const int nr = static_cast<int>(std::ceil(br / res));
+        bool blocked = false;
+        Vec3f last_p = p_now;
+        for (double t = now_t; t <= t_end && !blocked; t += 0.02) {
+            const Vec3f p = cmd_traj_info_.getPos(t);
+            if ((p - last_p).norm() < 0.5 * res && t > now_t) {
+                continue;
+            }
+            last_p = p;
+            if ((p - p_now).norm() < skip_dis) {
+                continue;
+            }
+            if (map_ptr_->getInfGridType(p) != rog_map::GridType::OCCUPIED) {
+                continue;
+            }
+            for (int i = -nr; i <= nr && !blocked; i++) {
+                for (int j = -nr; j <= nr && !blocked; j++) {
+                    for (int k = -nr; k <= nr && !blocked; k++) {
+                        const Vec3f d(i * res, j * res, k * res);
+                        if (d.norm() > br) {
+                            continue;
+                        }
+                        const Vec3f q = p + d;
+                        if (map_ptr_->isOccupied(q)) {
+                            blocked = true;
+                            hit_p = p;
+                            hit_dt = t - now_t;
+                        }
+                    }
+                }
+            }
+        }
+        cmd_traj_info_.unlock();
+        return blocked;
+    }
