    },
    "Image!feature": {
      "imageMode": { "imageTopic": "/photometric/feature_image" },
      "foxglovePanelTitle": "Photometric features"
    },
    "RawMessages!analytics": {
      "topicPath": "/analytics",
      "foxglovePanelTitle": "Analytics (obs_score / obs_min)"
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": { "speed": 1 },
  "layout": {
