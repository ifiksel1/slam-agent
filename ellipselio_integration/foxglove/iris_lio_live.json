        "targetOrientation": [0, 0, 0, 1],
        "fovy": 45,
        "near": 0.5,
        "far": 5000
      },
      "foxglovePanelTitle": "IRIS-LIO map + trajectory"
    },
    "Plot!infofrac": {
      "paths": [
        { "value": "/photometric/info_frac.data", "enabled": true, "timestampMethod": "receiveTime", "label": "info_frac (photo share of constraint)" }
