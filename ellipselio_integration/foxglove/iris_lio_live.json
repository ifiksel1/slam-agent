      "xAxisVal": "timestamp",
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "isSynced": true,
      "sidebarDimension": 240,
      "foxglovePanelTitle": "COIN-LIO contribution: info_frac (rises as geometry degenerates)"
    },
    "Plot!info": {
      "paths": [
        { "value": "/photometric/geo_info.data", "enabled": true, "timestampMethod": "receiveTime", "label": "geo_info" },
        { "value": "/photometric/photo_info.data", "enabled": true, "timestampMethod": "receiveTime", "label": "photo_info" }
      ],
      "xAxisVal": "timestamp",
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "isSynced": true,
      "sidebarDimension": 240,
      "foxglovePanelTitle": "Fisher info: geometry vs photometric"
    },
    "Plot!activity": {
      "paths": [
        { "value": "/photometric/n_rows.data", "enabled": true, "timestampMethod": "receiveTime", "label": "n_rows (active photo residuals)" },
        { "value": "/photometric/res_rms.data", "enabled": true, "timestampMethod": "receiveTime", "label": "res_rms (intensity residual)" }
      ],
      "xAxisVal": "timestamp",
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "isSynced": true,
      "sidebarDimension": 240,
