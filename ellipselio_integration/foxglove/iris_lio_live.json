        "second": "Image!feature"
      }
    },
    "second": {
      "direction": "column",
      "splitPercentage": 30,
      "first": "Plot!infofrac",
      "second": {
        "direction": "column",
        "splitPercentage": 43,
        "first": "Plot!info",
        "second": {
          "direction": "column",
