<?xml version="1.0"?>
<!-- FAST-LIVO2 full stack: MAVROS + URDF/RSP + SLAM.
     Generated by SLAM Integration Agent — Phase 3 (2026-06-06).
     Reconciled against real repo — Phase 4 (2026-06-06):

     VISION BRIDGE NOTE: FAST-LIVO2 publishes /mavros/vision_pose/pose DIRECTLY
     (geometry_msgs/PoseStamped via LIVMapper::initializeSubscribersAndPublishers).
     The vision_to_mavros bridge node is therefore NOT included here — adding it
     would create two publishers on /mavros/vision_pose/pose and corrupt MAVROS EKF input.
     The set_origin.py helper (from vision_to_mavros pkg) IS kept for EKF origin init.

     Primary odometry topic: /aft_mapped_to_init (nav_msgs/Odometry) — use this for
     any consumers (path planners, monitors, diagnostics). NOT /Odometry.

     TF FIX (2026-06-07): Ouster IMU mounted upside-down → FAST-LIVO2 body frame (aft_mapped)
     was Ry(π) from base_link. Static TFs:
       (a) aft_mapped→base_link: os_imu→base_link inverse = rpy(0,π,0), T=[-0.006253,0.011775,-0.067645]
       (b) map→odom (identity): bridges MAVROS map island to SLAM tree
     FAST-LIVO2's direct /mavros/vision_pose/pose remapped to dead topic in slam.launch.

     YAW-ZERO FIX (2026-06-07): gravity-align gives correct z-up but a non-repeatable
     world yaw (was ~-81° at rest). zero_initial_yaw.py measures yaw0 of base_link in
     camera_init after init and publishes a LATCHED static odom→camera_init = Rz(-yaw0)
     (translation 0). Identity odom→camera_init removed — that node now owns it.
     Chain: map→odom→camera_init(Rz(-yaw0))→aft_mapped→base_link.
     vision_to_mavros bridge target changed camera_init→map so vision_pose = base_link in
     the yaw-zeroed map → ~identity at rest & level, repeatable across restarts.
-->
<launch>

  <!-- ===== MAVROS (ArduPilot) ===== -->
  <!-- Stable by-id path survives reboots/remapping. CubeOrange USB CDC ignores baud, 115200 nominal. -->
  <arg name="fcu_url" default="/dev/serial/by-id/usb-Hex_ProfiCNC_CubeOrange-bdshot_450035000851313231383238-if00:115200"/>
  <arg name="gcs_url" default=""/>
  <include file="$(find mavros)/launch/apm.launch">
    <arg name="fcu_url" value="$(arg fcu_url)"/>
    <arg name="gcs_url" value="$(arg gcs_url)"/>
  </include>

  <!-- ===== Robot description / TF ===== -->
  <param name="robot_description" textfile="$(find fast_livo2_integration)/urdf/drone.urdf"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>

  <!-- ===== TF fix: aft_mapped → base_link (Step 1) =====
       Corrects Ouster IMU upside-down mounting (Ry(π)).
       Transform = inverse of base_link→os_imu: rpy=(0,π,0), T=[-0.006253,0.011775,-0.067645].
       Args order: x y z yaw pitch roll parent child. -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="aft_mapped_to_base_link"
        args="-0.006253 0.011775 -0.067645 0 3.14159265 0 aft_mapped base_link"/>

  <!-- ===== TF fix: map → odom (identity, Step 2) =====
       Identity bridge connects the MAVROS-owned map island to the SLAM tree.
       odom → camera_init is owned by zero_initial_yaw (latched Rz(-yaw0)) — NOT here.
       MAVROS local_position.tf.send=false (verified in apm_config.yaml) — no base_link conflict. -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="map_to_odom"
        args="0 0 0 0 0 0 map odom"/>

  <!-- ===== SLAM (Ouster driver + FAST-LIVO2) ===== -->
  <include file="$(find fast_livo2_integration)/launch/slam.launch">
    <arg name="viz" value="false"/>
  </include>

  <!-- ===== Initial-yaw zeroing (latched odom → camera_init = Rz(-yaw0)) =====
       Measures yaw0 of base_link in camera_init after FAST-LIVO2 init, then publishes a
       latched static odom→camera_init that cancels it. Preserves gravity-aligned z-up
       (roll/pitch untouched). Makes vision-world yaw repeatable across restarts.
       Flip ~sign to 1.0 only if world yaw lands at ~ -2*yaw0 instead of ~0. -->
  <node pkg="fast_livo2_integration" type="zero_initial_yaw.py" name="zero_initial_yaw" output="screen">
    <param name="parent_frame"   value="odom"/>
    <param name="child_frame"    value="camera_init"/>
    <param name="measure_parent" value="camera_init"/>
    <param name="measure_child"  value="base_link"/>
    <param name="settle_time"    value="5.0"/>
    <param name="num_samples"    value="20"/>
    <param name="sample_interval" value="0.1"/>
    <param name="sign"           value="-1.0"/>
  </node>

  <!-- ===== vision_to_mavros bridge (Step 3) =====
       Looks up base_link in MAP via TF (use_tf=true) and publishes the pose.
       target=map (yaw-zeroed via odom→camera_init=Rz(-yaw0)); source=base_link.
       gamma_world=0 / roll/pitch/yaw_cam=0: no extra rotation — the static TFs (Ry(π)
       correction + Rz(-yaw0) yaw-zero) already encode the full orientation correction.
       ~/vision_pose remapped to /mavros/vision_pose/pose. FAST-LIVO2's direct publisher is
       remapped to /fastlivo/vision_pose_unused in slam.launch to prevent dual-publisher conflict. -->
  <node pkg="vision_to_mavros" type="vision_to_mavros_node" name="vision_to_mavros_bridge" output="screen">
    <param name="use_tf"          value="true"/>
    <param name="target_frame_id" value="map"/>
    <param name="source_frame_id" value="base_link"/>
    <param name="output_rate"     value="30"/>
    <param name="gamma_world"     value="0"/>
    <param name="roll_cam"        value="0"/>
    <param name="pitch_cam"       value="0"/>
    <param name="yaw_cam"         value="0"/>
    <remap from="~vision_pose" to="/mavros/vision_pose/pose"/>
  </node>

  <!-- ===== EKF origin setter ===== -->
  <!-- Sets ArduPilot EKF origin = map origin so MAVROS/ArduPilot knows the global reference.
       Uses the python3-fixed copy in this package (image-baked vision_to_mavros/set_origin.py
       has a "#!/usr/bin/env python" shebang → exit 127 on Noetic). Does NOT bridge odom→pose. -->
  <node pkg="fast_livo2_integration" type="set_origin.py" name="set_origin_node" output="screen"/>

</launch>
