<?xml version="1.0"?>
<!-- FAST-LIVO2 SLAM: working ARM64 Ouster driver + FAST-LIVO2 (LiDAR-inertial-only).
     Generated by SLAM Integration Agent — Phase 3 (2026-06-06).
     Reconciled against real repo — Phase 4 (2026-06-06):
       - pkg="fast_livo" type="fastlivo_mapping" confirmed correct.
       - Main config loaded at LAUNCH level (not inside node) per upstream pattern.
       - Camera yaml REQUIRED even when img_en=0; minimal placeholder loaded inside node.
       - Ouster default hostname updated to 192.168.2.60 (static IP set Phase 4 Stage 1).
       - FAST-LIVO2 publishes /mavros/vision_pose/pose directly; vision bridge not in this file. -->
<launch>

  <!-- ===== Ouster OS1-64 ===== -->
  <!-- Uses the ultraviewdev_ws ARM64-safe ouster_ros driver (stock nodelets crash exit 255 on Orin). -->
  <arg name="ouster_hostname" default="$(optenv OS_IP 192.168.2.60)"/>
  <arg name="ouster_udp_dest" default="$(optenv DEST_IP 192.168.2.50)"/>
  <arg name="lidar_mode"      default="1024x20"/>   <!-- fallback 512x20 if drops (see config) -->
  <arg name="timestamp_mode"  default="TIME_FROM_INTERNAL_OSC"/>
  <arg name="viz"             default="false"/>

  <include file="$(find ouster_ros)/launch/driver.launch">
    <arg name="sensor_hostname" value="$(arg ouster_hostname)"/>
    <arg name="udp_dest"        value="$(arg ouster_udp_dest)"/>
    <arg name="lidar_mode"      value="$(arg lidar_mode)"/>
    <arg name="timestamp_mode"  value="$(arg timestamp_mode)"/>
    <arg name="point_type"      value="original"/>   <!-- carries per-point t + reflectivity -->
    <arg name="proc_mask"       value="IMU|PCL"/>     <!-- LiDAR-inertial only; skip SCAN/IMG/RAW -->
    <arg name="viz"             value="$(arg viz)"/>
  </include>

  <!-- ===== FAST-LIVO2 main config (loaded at launch level per upstream pattern) ===== -->
  <rosparam command="load" file="$(find fast_livo2_integration)/config/fast_livo2_ouster64.yaml"/>

  <!-- ===== FAST-LIVO2 node ===== -->
  <!-- pkg/type confirmed against real repo: fast_livo / fastlivo_mapping / laserMapping -->
  <node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
    <!-- Camera yaml REQUIRED by LIVMapper even when img_en=0 (always read in initializeSubscribersAndPublishers). -->
    <rosparam command="load" file="$(find fast_livo2_integration)/config/camera_minimal.yaml"/>
    <!-- Step 3: silence FAST-LIVO2's direct vision_pose output — the corrected bridge in master.launch
         drives MAVROS instead. Prevents dual-publisher corruption of the MAVROS EKF input. -->
    <remap from="/mavros/vision_pose/pose" to="/fastlivo/vision_pose_unused"/>
  </node>

</launch>
