+    def imu_callback(self, msg):
+        w = msg.angular_velocity
+        if self.frozen_repeats > 0 and math.sqrt(w.x * w.x + w.y * w.y + w.z * w.z) >= self.frozen_gyro_min:
+            self.frozen_moving = True
+
+    def frozen_check(self, odom_msg):
+        """True while the pose is frozen (vision must not go out). Counts repeated raw poses."""
+        if self.frozen_min_n <= 0:
+            return False
+        p, q = odom_msg.pose.pose.position, odom_msg.pose.pose.orientation
+        cur = (p.x, p.y, p.z, q.x, q.y, q.z, q.w)
+        last, self.frozen_last = self.frozen_last, cur
+        same = (last is not None
+                and math.sqrt(sum((a - b) ** 2 for a, b in zip(cur[:3], last[:3]))) <= self.frozen_eps_m
+                and all(abs(a - b) <= self.frozen_eps_q for a, b in zip(cur[3:], last[3:])))
+        if not same:
+            self.frozen_repeats = 0
+            self.frozen_moving = False
+            if self.frozen:
+                self.frozen = False
+                rospy.logwarn("SLAM pose moving again: vision resumed (re-anchors as after a gap)")
+                self.send_statustext("SLAM moving again: vision resumed")
+            return False
+        self.frozen_repeats += 1
+        if not self.frozen and self.frozen_repeats >= self.frozen_min_n and (
+                self.frozen_moving or not self.frozen_require_motion):
+            self.frozen = True
+            rospy.logerr("SLAM pose frozen (%d repeats): vision pose and speed STOPPED, the FC's failsafe takes over",
+                         self.frozen_repeats)
+            self.send_statustext("SLAM frozen: vision stopped")
+        return self.frozen
+
     def odometry_callback(self, odom_msg):
