<launch>
  <!-- flight yaw (owner rule 2026-10-29): the bridge with ~flight_yaw travel (the default) -->
  <node pkg="l4_bridge" type="planner_bridge" name="planner_bridge" output="log">
    <param name="speed_cap" value="1.0"/>
    <!-- the FC's yaw is fixed here, off the travel direction: these cases check SUPER's command streamed as
         it is; the turn slowdown has its own test (turn_slow_node.test) -->
    <param name="turn_slow_enable" value="false"/>
  </node>
  <test test-name="test_bridge_yaw_node" pkg="l4_bridge" type="test_bridge_yaw_node" time-limit="120.0"/>
</launch>
