        "/planner/cloud": {"visible": true, "pointSize": 3, "colorMode": "flat", "flatColor": "#ffffffaa"},
        "/planner/odom": {"visible": false},
        "/robot/sphere": {"visible": true},
        "/robot/body": {"visible": true},
        "/robot/nearest": {"visible": true},
        "/robot/clearance": {"visible": true},
        "/fsm_node/visualization/exp_traj": {"visible": true},
        "/fsm_node/visualization/backup_traj": {"visible": true},
        "/fsm_node/visualization/committed_traj": {"visible": true},
        "/fsm_node/visualization/exp_sfc": {"visible": true},
        "/fsm_node/visualization/backup_sfc": {"visible": true},
        "/fsm_node/visualization/goal": {"visible": true},
        "/track_planner/path": {"visible": true, "type": "line", "lineWidth": 0.08, "gradient": ["#00e5ffff", "#00e5ffff"]},
        "/planning/drive_goal": {"visible": true, "type": "arrow", "arrowScale": [0.6, 0.15, 0.15], "color": "#00e5ffff"},
        "/planning/click_goal": {"visible": true, "type": "arrow", "arrowScale": [0.6, 0.15, 0.15], "color": "#ffcc00ff"},
        "/planner/landing_markers": {"visible": true},
        "/planner/landing_spot": {"visible": true}
      }
    },
    "Plot!heightspeed": {
      "title": "height, speed, bridge mode, mission phase",
      "paths": [
        {"value": "/viz/height.data", "enabled": true, "label": "height (m, odometry z)"},
        {"value": "/viz/speed.data", "enabled": true, "label": "horizontal speed (m/s)"},
        {"value": "/planner_bridge/mode_code.data", "enabled": true, "label": "bridge mode (0 off, 1 flight, 2 drive)"},
        {"value": "/viz/phase.data", "enabled": false, "label": "phase (1 takeoff 2 fly 3 drive 4 check 5 land 7 done)"}
      ],
      "showLegend": true,
      "legendDisplay": "top",
      "xAxisVal": "timestamp"
    },
    "StateTransitions!mode": {
      "paths": [
        {"value": "/planner_bridge/mode.data", "timestampMethod": "receiveTime"},
        {"value": "/planner_bridge/mode_code.data", "timestampMethod": "receiveTime"},
        {"value": "/viz/phase.data", "timestampMethod": "receiveTime"}
      ],
      "isSynced": true
    },
    "RawMessages!exec": {
      "topicPath": "/mission_executive/status",
      "diffEnabled": false,
      "expansion": "all"
    },
    "RawMessages!landing": {
      "topicPath": "/planner/landing_status",
      "diffEnabled": false,
      "expansion": "all"
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": {"speed": 1},
  "layout": {
    "direction": "column",
    "first": {
      "direction": "row",
      "first": "3D!drivefly",
      "second": {
        "direction": "column",
        "first": "RawMessages!exec",
        "second": "RawMessages!landing",
        "splitPercentage": 45
      },
      "splitPercentage": 72
    },
    "second": {
      "direction": "row",
      "first": "Plot!heightspeed",
      "second": "StateTransitions!mode",
      "splitPercentage": 62
    },
    "splitPercentage": 70
  }
