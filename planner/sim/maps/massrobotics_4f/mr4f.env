# Mass Robotics 4th floor sim map (2026-10-30 drive + flights), Shannon paths. Sourced by the mr4f wrappers.
# Workspace ~/sim/mr4f is an L2_BASE (planner_sim, planner, slam, runs, cpp_ws/install), separate from the
# owner's ~/sim/click and the other agents' trees.
# Default: the 2026-11-02 re-drive (mr4f_1102: 52 loop pairs, straight walls). The 2026-10-30 map (mr4f_1030) has
# ~30 deg of heading drift between its east and west halves; missions/mr4f_smoke.yaml and mr4f_aisle.yaml were
# written for it: MR4F_MAP=$HOME/sim/maps/massrobotics_4f/mr4f_1030.pcd MR4F_START="-0.14 0.04 85.7" (smoke).
MR4F_MAP=${MR4F_MAP:-$HOME/sim/maps/massrobotics_4f/mr4f_1102.pcd}
# start (map frame, m, deg): where the recording began, on the floor, facing the robot's start heading
# (mr4f_1102). Overridable, e.g. on mr4f_1030 for missions/mr4f_aisle.yaml: MR4F_START="-12.11 15.39 -88".
MR4F_START=${MR4F_START:-"0.01 -0.01 -91.1"}
MR4F_SUPER=$HOME/sim/mr4f/planner_sim/super_closed_loop_mr4f.yaml
export L2_BASE=${L2_BASE:-$HOME/sim/mr4f}
# the build with the landing-spot search (7d12e2c); all L4 packages in one install space
export L4_WS=${L4_WS:-$HOME/sim/landsearch/cpp_ws/install}          # l4_track, l4_landing
export L4_BRIDGE_WS=${L4_BRIDGE_WS:-$HOME/sim/landsearch/cpp_ws/install}  # l4_bridge, l4_executive, l4_click, l4_sim_viz
