     Vector3d get_position_relhome() const;
 
+    // SIM ONLY (sitl_roof.patch): the ground under the vehicle above the home ground (SIM_ROOF), m
+    float ground_offset() const { return ground_height_difference(); }
+
     // get air density in kg/m^3
     float get_air_density(float alt_amsl) const;
 
